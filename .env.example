# ---------------------------------------------------------------------------
# Kisan Mitra — environment template
#
# Copy to `.env` for local development (backend) and `web/.env.local` for the
# frontend. NEVER put real credentials in this file or any committed file.
# Values below are safe placeholders; the app fails fast if a required value
# is missing.
#
# Variable names follow IMPLEMENTATION_PLAN.md §20.2.
# ---------------------------------------------------------------------------

# --- Backend / database ----------------------------------------------------
# SQLAlchemy URL. Local development uses Postgres 17 (Homebrew, port 5432).
DATABASE_URL=postgresql+psycopg://kisan_mitra:CHANGE_ME_LOCAL_ONLY@localhost:5432/kisan_mitra_dev

# --- Auth ------------------------------------------------------------------
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET
JWT_ACCESS_TOKEN_TTL_MINUTES=30

# --- Object storage --------------------------------------------------------
# STORAGE_DRIVER=local  -> development only, writes under STORAGE_LOCAL_DIR
# STORAGE_DRIVER=s3     -> any S3-compatible bucket, required in deployment
# The plan §20.2 names OBJECT_STORAGE_KEY; the AWS-compatible names used by
# boto3 are *_ACCESS_KEY_ID / *_SECRET_ACCESS_KEY. Both spellings are listed
# until the storage phase freezes one (see docs/ASSUMPTIONS.yaml, Q-06).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.uploads
OBJECT_STORAGE_ENDPOINT=https://s3.example.com
OBJECT_STORAGE_BUCKET=kisan-mitra-uploads
OBJECT_STORAGE_KEY=
OBJECT_STORAGE_SECRET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_REGION=ap-south-1

# --- LLM (Google Gemini, behind the ManagedAPIProvider adapter) -----------
# Plan §9.1: provider selection is configuration, never code.
# Never expose this key to the browser bundle (no NEXT_PUBLIC_ prefix).
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=6000
LLM_MAX_OUTPUT_TOKENS=512
LLM_RATE_LIMIT_PER_10MIN=20

# --- ML inference ----------------------------------------------------------
ML_MODEL_PATH=ml/export/model.onnx
ML_CONFIDENT_P_MAX=0.80
ML_MARGIN_MIN=0.30
ML_LOW_P_MAX=0.45
ML_INFERENCE_TIMEOUT_MS=5000

# --- HTTP / ops ------------------------------------------------------------
# Comma-separated exact origins. Development default is the Next.js dev server.
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
# Off by default: assistant message bodies may contain personal farm details.
LOG_MESSAGE_BODY=false
