# Copy to backend/.env for local dev. Never commit the real .env.
ENV=dev
DATABASE_URL=postgresql+psycopg://kisan:kisan@localhost:5432/kisan
# Must be >= 32 random characters in prod: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-dev-only-change-me-0000
JWT_TTL_HOURS=12
COOKIE_SECURE=false

# Photo quality gate (plan §9.7). Leave empty to disable a check; set from real phone photos.
BLUR_MIN=
BRIGHT_MIN=
BRIGHT_MAX=
# Leave empty to use the validated thresholds in app/ml/model/model.json.
CONF_ACCEPT=
CONF_FLOOR=

# Groq: key from console.groq.com/keys, model ID from console.groq.com/docs/models.
# Leave empty to use template reports.
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_S=25
LLM_FORCE_FAIL=false
# data.gov.in mandi prices: free key from data.gov.in. Empty = admin-entered prices only (demo rows if the
# admin switches them on in Settings).
DATAGOV_API_KEY=

# Online payments through Razorpay TEST mode (free account at dashboard.razorpay.com, Test Mode keys; no real
# money moves). Leave empty to offer only UPI-to-farmer and cash, which the farmer confirms.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# First admin account, created by `python -m app.seed` (admins can't self-register).
ADMIN_PHONE=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Only for `python -m app.seed --demo` (local testing; demo accounts share this password)
SEED_DEMO_PASSWORD=
