# Copy to backend/.env for local dev. Never commit the real .env.
ENV=dev
DATABASE_URL=postgresql+psycopg://kisan:kisan@localhost:5432/kisan
# Must be >= 32 random characters in prod: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-dev-only-change-me-0000
JWT_TTL_HOURS=12
COOKIE_SECURE=false

# Inference is a mock until the real ONNX model lands (plan §9). MOCK_STATUS forces a status for UI work:
# ok | uncertain | unsupported | rejected_quality | error
MOCK_STATUS=ok
# Thresholds come from validation runs (plan §9.7). Leave empty to disable the check.
BLUR_MIN=
BRIGHT_MIN=
BRIGHT_MAX=
CONF_ACCEPT=
CONF_FLOOR=

LLM_API_KEY=
LLM_MODEL=
DATAGOV_API_KEY=

# Required by `python -m app.seed` (demo accounts share this password)
SEED_DEMO_PASSWORD=
